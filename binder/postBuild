#!/bin/bash

set -x
set -e
set -u
set -o pipefail

# Debug: Show all environment variables
echo "Environment variables:"
printenv | sort

# Check if running on a JupyterHub service (mybinder.org, GESIS Notebooks, or other JupyterHub)
# Added check for /home/jovyan which is the standard JupyterHub user home
if [[ -n "${JUPYTERHUB_SERVICE_PREFIX:-}" || -n "${JUPYTERHUB_API_URL:-}" || -n "${JUPYTERHUB_HOST:-}" || -d /usr/local/bin/jupyterhub-singleuser || "$HOME" == "/home/jovyan" ]]; then
    echo "Running on JupyterHub service - optimizing for container reuse"
    # Move frequently changing steps to the end
    export BINDER_OPTIMIZED=true
else
    echo "Running in local environment - using standard setup"
    export BINDER_OPTIMIZED=false
fi

# Function to check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Create local bin directory if it doesn't exist
mkdir -p ~/.local/bin
export PATH="$HOME/.local/bin:$PATH"

# Install core system packages (minimal set for binder caching)
apt-get update && apt-get install --yes \
    libsqlite3-dev \
    htop \
    strace \
    ltrace \
    lsof \
    ncdu \
    tree \
    jq \
    ripgrep

# Install Python SQLite dependencies (essential for binder)
# First ensure system SQLite is properly installed
apt-get install -y --no-install-recommends libsqlite3-dev sqlite3
pip install --user pysqlite3 sqlean.py

# Configure Python to use the latest SQLite
echo "Reconfiguring Python SQLite bindings..."
python3 -c "import sqlite3; print(f'SQLite version: {sqlite3.sqlite_version}')"

# Install bash kernel with better error handling and debugging
echo "Attempting to install bash kernel..."
if python -m bash_kernel.install; then
    echo "Bash kernel installed successfully"
else
    echo "Warning: Failed to install bash kernel through pip, trying alternative method..."
    # Try installing directly from conda-forge
    if conda install -c conda-forge bash_kernel -y; then
        echo "Bash kernel installed successfully via conda-forge"
    else
        echo "Error: Could not install bash kernel through either pip or conda"
        echo "This is non-fatal - continuing with other setup steps"
    fi
fi



# Install Miller with error handling
echo "Installing Miller..."
if ! (cd ~/.local/bin && \
    wget -q https://github.com/johnkerl/miller/releases/download/v6.12.0/miller-6.12.0-linux-amd64.tar.gz && \
    tar --strip-components=1 -xzf miller-6.12.0-linux-amd64.tar.gz && \
    chmod +x ./mlr); then
    echo "Failed to install Miller" >&2
    exit 1
fi

# Install fx with error handling
echo "Installing fx..."
if ! (cd ~/.local/bin && \
    wget -q https://github.com/antonmedv/fx/releases/download/35.0.0/fx_linux_amd64 && \
    mv fx_linux_amd64 fx && \
    chmod +x ./fx); then
    echo "Failed to install fx" >&2
    exit 1
fi

## Install DuckDB with error handling
echo "Installing DuckDB..."
if ! (cd ~/.local/bin && \
    wget -q https://github.com/duckdb/duckdb/releases/download/v1.1.3/duckdb_cli-linux-amd64.zip && \
    unzip duckdb_cli-linux-amd64.zip && \
    chmod +x ./duckdb && \
    duckdb -c "INSTALL spatial;INSTALL httpfs;INSTALL json"); then
    echo "Failed to install DuckDB" >&2
    exit 1
fi

# Create DuckDB config with error handling
echo "Configuring DuckDB..."
if ! cat <<EOL > ~/.duckdbrc
.timer on
.width 180
LOAD json;
LOAD parquet;
LOAD spatial;
EOL
then
    echo "Failed to create DuckDB config" >&2
    exit 1
fi

# Install code quality tools (moved to end for binder optimization)
echo "Installing code quality tools..."
pip install --user \
    black \
    isort \
    flake8 \
    mypy \
    pylint \
    bandit \
    safety

# Install Oh My Zsh (zsh already installed via apt.txt)

# Install Oh My Zsh silently
sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended

# Optional: install plugins for Oh My Zsh
git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting
git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions

# Enable plugins in the .zshrc file
sed -i 's/plugins=(git)/plugins=(git zsh-syntax-highlighting zsh-autosuggestions)/' ~/.zshrc

# set zsh as default shell
# chsh -s /path/to/zsh

# You can start zsh manually later, or add a note to users to run 'zsh' in the terminal.

# Install uv with error handling (moved to end for binder optimization)
if [[ "$BINDER_OPTIMIZED" == "false" ]]; then
    echo "Installing uv..."
    if ! curl -LsSf https://astral.sh/uv/install.sh | sh; then
        echo "Failed to install uv" >&2
        exit 1
    fi
else
    echo "Skipping uv installation on binder for optimization"
fi

# Install llm plugins with error handling
echo "Installing llm plugins..."
if ! (llm install llm-groq && llm install llm-mistral); then
    echo "Failed to install llm plugins" >&2
    exit 1
fi

# Install Playwright with error handling
echo "Installing Playwright..."
if ! shot-scraper install -b chromium; then
    echo "Failed to install Playwright" >&2
    exit 1
fi

# Enable nbgitpuller (new method for JupyterLab 3.x)
jupyter server extension enable --py nbgitpuller --sys-prefix

# Verify GDAL/OGR Parquet support
echo "Verifying OGR Parquet support..."
if ogrinfo --formats 2>/dev/null | grep -qi Parquet; then
    echo "OGR Parquet support confirmed"
    echo "Testing Parquet support with sample data..."
    wget -q https://github.com/opengeospatial/geoparquet/raw/main/examples/example.parquet
    ogrinfo example.parquet
else
    echo "ERROR: OGR Parquet support not found" >&2
    echo "Trying to fix by reinstalling libgdal-arrow-parquet..."
    conda install -c conda-forge libgdal-arrow-parquet -y
    if ogrinfo --formats 2>/dev/null | grep -qi Parquet; then
        echo "OGR Parquet support successfully fixed!"
    else
        echo "ERROR: Could not enable Parquet support" >&2
        echo "This may require manual intervention or environment rebuild"
    fi
fi

# Copy JupyterLab configuration if it exists
mkdir -p ~/.jupyter/lab
if [[ -f .jupyter/lab/user-settings.json ]]; then
    cp -r .jupyter/lab/user-settings.json ~/.jupyter/lab/
else
    echo "No JupyterLab user settings found - using defaults"
fi

# Final message
echo "Setup completed successfully!"
echo "Useful commands:"
echo "  htop - system monitoring"
echo "  rg - ripgrep for fast searching"
echo "  bat - better cat"
echo "  fd - better find"
echo "  exa - better ls"
echo ""
